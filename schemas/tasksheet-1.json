{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starship.internal/schemas/tasksheet-1.json",
  "title": "TaskSheet v1",
  "description": "Starship Control Plan Execution Schema (tasksheet/1)",
  "type": "object",
  "required": [
    "version",
    "goal",
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "description": "Format version number (must be 1 for tasksheet/1)"
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "description": "User intent or high-level mission objective"
    },
    "title": {
      "type": "string",
      "description": "Short title for the workflow"
    },
    "summary": {
      "type": "string",
      "description": "Detailed explanation of what the plan achieves"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "description": "Ordered DAG steps for execution (max 30 steps)",
      "items": {
        "type": "object",
        "required": [
          "step_index",
          "app_id",
          "tool_name",
          "arguments",
          "risk_tier"
        ],
        "additionalProperties": false,
        "properties": {
          "step_index": {
            "type": "integer",
            "minimum": 0,
            "description": "Zero-based step index"
          },
          "app_id": {
            "type": "string",
            "enum": [
              "eep",
              "ssp",
              "alp",
              "nwp",
              "atp"
            ],
            "description": "Canonical ID of the target sub-application"
          },
          "tool_name": {
            "type": "string",
            "minLength": 1,
            "description": "Identifier of the tool to invoke"
          },
          "arguments": {
            "type": "object",
            "description": "Tool parameters conforming to the tool's schema"
          },
          "risk_tier": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3,
            "description": "Safety tier: 1=Safe, 2=Mutating, 3=Destructive"
          },
          "diff_summary": {
            "type": "string",
            "description": "Human-readable explanation of changes"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "description": "Step indices that must succeed before this step"
          }
        }
      }
    }
  }
}
